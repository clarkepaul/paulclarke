<!DOCTYPE html>
<html lang="en-NZ">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }}</title>
	<meta name="description" content="{{ description }}">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=Fraunces:opsz,wght@9..144,400;9..144,500&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
	{%- if extraFonts %}
	<link href="{{ extraFonts }}" rel="stylesheet">
	{%- endif %}
	<link rel="stylesheet" href="/css/site.css">
	{%- if extraStylesheet %}
	<link rel="stylesheet" href="{{ extraStylesheet }}">
	{%- endif %}
	<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
	<link rel="apple-touch-icon" href="/apple-touch-icon.png">

	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analyticsId }}"></script>
	<script>
	  window.dataLayer = window.dataLayer || [];
	  function gtag(){dataLayer.push(arguments);}
	  gtag('js', new Date());
	  gtag('config', '{{ site.analyticsId }}');
	</script>
	{%- if cvRedirect %}
	<script>
	  // Old "Download my CV" links pointed to resume.html?print; send them to the PDF.
	  if (new URLSearchParams(location.search).has('print')) location.replace('/Paul-Clarke-CV.pdf');
	</script>
	{%- endif %}
</head>

<body class="{{ bodyClass }}">
	<a class="skip-link" href="#main">Skip to content</a>

	<header class="site-header">
		<a class="site-header__name" href="/">{{ site.name }}</a>
		<nav class="site-nav" aria-label="Main">
			<ul>
				{%- for item in site.nav %}
				<li><a href="{{ item.url }}"{% if item.key == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
				{%- endfor %}
			</ul>
		</nav>
	</header>

	<main id="main">
		{{ content | safe }}
	</main>

	{%- if hasEmail %}
	<script src="/js/email.js"></script>
	{%- endif %}
</body>
</html>
